# Browser-safe (exposed via /api/public-config, NOT NEXT_PUBLIC/VITE build vars — this is plain static hosting)
CHAT_SUPABASE_URL=
CHAT_SUPABASE_ANON_KEY=

# Server-only
CHAT_SUPABASE_SERVICE_ROLE_KEY=
MAIN_NIAGABIO_SUPABASE_URL=
MAIN_NIAGABIO_SUPABASE_SERVICE_ROLE_KEY=
# Sesuaikan dengan skema Supabase #1 (NiagaBio utama).
MAIN_NIAGABIO_TABLE=profiles
MAIN_NIAGABIO_EMAIL_COLUMN=email

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Model yang dipakai KHUSUS saat user kirim foto (harus mendukung vision/gambar).
# Kalau kosong, fallback ke OPENROUTER_MODEL di atas.
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
ADMIN_WHATSAPP=085191245042
ADMIN_WHATSAPP_URL=https://wa.me/6285191245042
